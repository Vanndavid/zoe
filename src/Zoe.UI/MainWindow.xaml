<Window x:Class="Zoe.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoe — AI Mentor"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Zoe" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="  —  Your AI Mentor" FontSize="14" VerticalAlignment="Center" Opacity="0.7"/>
            <Button Content="{Binding MonitoringButtonText}" Command="{Binding ToggleMonitoringCommand}"
                    Margin="24,0,0,0" Padding="12,4"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Timeline">
                <ListView ItemsSource="{Binding TimelineItems}" Margin="8">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="80"/>
                            <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="120"/>
                            <GridViewColumn Header="Application" DisplayMemberBinding="{Binding Application}" Width="150"/>
                            <GridViewColumn Header="Details" DisplayMemberBinding="{Binding Details}" Width="400"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
            <TabItem Header="Goals">
                <StackPanel Margin="8">
                    <TextBlock Text="Active Goals" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListView ItemsSource="{Binding Goals}" Height="200">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}" Width="80"/>
                                <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="400"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </TabItem>
            <TabItem Header="Settings">
                <StackPanel Margin="8">
                    <CheckBox Content="Enable monitoring" IsChecked="{Binding MonitoringEnabled}" Margin="0,4"/>
                    <CheckBox Content="Auto-start with Windows" IsChecked="{Binding AutoStart}" Margin="0,4"/>
                    <TextBlock Text="Life Profile (tell Zoe how you live and what you want)" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding LifeProfile, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="120" TextWrapping="Wrap"/>
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Margin="0,8,0,0" Padding="12,4" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Opacity="0.6" Margin="0,8,0,0"/>
    </Grid>
</Window>
